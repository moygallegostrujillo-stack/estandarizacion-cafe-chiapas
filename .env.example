# ============================================================
# VARIABLES DE ENTORNO — Café DeChiapas Estandarización v2.1
# ============================================================
# Copia este archivo a .env.local y completa los valores
# con los datos de tu proyecto Supabase "Estandarizacion V2"

# ---------- BASE DE DATOS (Supabase → Settings → Database → Connection string) ----------
# String de conexión para Prisma. Usa la "Transaction mode" URL (puerto 6543).
DATABASE_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# String directo (para migraciones, puerto 5432)
DIRECT_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------- SUPABASE (Supabase → Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL="https://[PROYECTO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"  # ⚠️ NUNCA exponer en el frontend

# ---------- AUTH.JS ----------
# Generar con: openssl rand -base64 32
AUTH_SECRET="[GENERAR_SECRETO_ALEATORIO]"

# ---------- APP ----------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Café DeChiapas"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
